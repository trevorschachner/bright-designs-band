# Copy to .env.local and fill in. Validated by lib/env.ts.
# A value of **** (Netlify build-time masking) is treated as unset.

# --- Site ---
# Canonical public origin, e.g. https://www.brightdesigns.band (falls back to that when unset or invalid)
NEXT_PUBLIC_SITE_URL=

# --- Database ---
# Postgres connection string (postgres:// or postgresql://); required at runtime by DB routes
DATABASE_URL=

# --- Supabase (auth + storage) ---
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key (optional; server-only scripts)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ---
# Provider: resend | gmail | smtp (default resend)
EMAIL_SERVICE=
# Resend API key (EMAIL_SERVICE=resend)
RESEND_API_KEY=
# From address for outgoing mail (default hello@transactional.brightdesigns.band)
EMAIL_FROM=
# Contact-form recipient(s), comma-separated; used when ADMIN_EMAIL_ADDRESSES is unset
ADMIN_EMAIL=
# Contact-form recipients, comma-separated; takes precedence over ADMIN_EMAIL
ADMIN_EMAIL_ADDRESSES=
# Gmail account (EMAIL_SERVICE=gmail)
GMAIL_USER=
# Gmail app password, not the account password (EMAIL_SERVICE=gmail)
GMAIL_APP_PASSWORD=
# SMTP host (EMAIL_SERVICE=smtp)
SMTP_HOST=
# SMTP port, a number (default 587)
SMTP_PORT=
# SMTP username
SMTP_USER=
# SMTP password
SMTP_PASS=
# true for implicit TLS (port 465), false otherwise (default false)
SMTP_SECURE=

# --- Analytics ---
# PostHog project key (unset disables PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog API host or proxy path (default /ingest)
NEXT_PUBLIC_POSTHOG_HOST=

# --- Storage ---
# Supabase storage bucket (default "Bright Designs")
NEXT_PUBLIC_STORAGE_BUCKET=
# Root folder inside the bucket (default files)
NEXT_PUBLIC_STORAGE_ROOT_PREFIX=

# --- Turnstile (contact-form captcha) ---
# Cloudflare Turnstile site key (outside production, unset uses Cloudflare's always-pass test key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile secret (outside production, unset skips verification; in production, unset rejects all submissions)
TURNSTILE_SECRET_KEY=

# --- DB guards (scripts/migrate-db.js, scripts/push-db.js) ---
# Set true to allow migrations with NODE_ENV=production
ALLOW_DB_MIGRATE=
# Set true to allow drizzle push (non-production only)
ALLOW_DB_PUSH=

# --- Runtime (usually set by the platform) ---
# Process time zone (optional)
TZ=
# Set to true by Netlify on its builds and functions
NETLIFY=
# Set to true by `netlify dev`
NETLIFY_LOCAL=
